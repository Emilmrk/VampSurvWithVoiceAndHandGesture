# Clave de API de Google Gemini para interpretación natural de comandos de voz
# Obtén tu clave gratuita en: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# "auto" lista los modelos disponibles y elige siempre el más avanzado con cuota
GEMINI_MODEL=auto
GEMINI_TIMEOUT_SECONDS=2.5
GEMINI_COOLDOWN_SECONDS=60.0
